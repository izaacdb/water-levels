{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:contract": "node scripts/gen-contract.mjs",
    "e2e:serve": "vite build --outDir dist-e2e --emptyOutDir && rm -rf dist-e2e/data && cp -R e2e/fixtures/data dist-e2e/data && vite preview --outDir dist-e2e --port 4174 --strictPort",
    "e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
